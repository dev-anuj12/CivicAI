# Client-side configuration. These are safe to expose: Supabase's anon key is
# protected by the Row Level Security policies in database/schema.sql.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: pre-fills the administrator email field. Do not put a password here.
VITE_SUPER_ADMIN_EMAIL="admin@yourcity.gov.in"

# Gemini is optional and is only used by the AI image analysis feature.
VITE_GEMINI_API_KEY=""

# Vercel-only (add in Vercel dashboard; never put in this file or the browser):
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
